# Copy this file to .env and fill in your own values.
# .env is ignored by git — never commit it or share it.

# ── Instagram (required to publish and read metrics) ─────────────────────────
# A Page access token from a long-lived user token does not expire.
# See README → "Get your Instagram token".
IG_ACCESS_TOKEN=
# Your Instagram Business/Creator account id (a long number, not your @handle).
IG_USER_ID=
# Optional: Graph API version (default v24.0).
# IG_GRAPH_VERSION=v24.0

# ── Photos ───────────────────────────────────────────────────────────────────
# Google Photos shared album the photo picker chooses from.
# In Google Photos: album → Share → Create link. Anyone with this link can see the album.
GOOGLE_ALBUM_URL=

# ── AI backend (set one) ─────────────────────────────────────────────────────
# claude-code = use the Claude Code CLI with your own Claude subscription login
# (run `claude` once to log in). Default model: claude-haiku-5-5.
LLM_BACKEND=claude-code
# Or comment out LLM_BACKEND and set an API key instead (needed for Docker):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional: override the model, e.g. claude-sonnet-5-5
# LLM_MODEL=
# Optional: full path to the claude CLI if Claude Desktop can't find it, e.g.
# CLAUDE_CLI=C:\Users\<you>\AppData\Roaming\npm\claude.cmd

# ── Failure alerts (optional) ────────────────────────────────────────────────
# Get a message when a run fails (photo pick, publish, metrics...).
# Easiest: install the free ntfy app, subscribe to a hard-to-guess topic, and use
#   ALERT_WEBHOOK_URL=https://ntfy.sh/<your-secret-topic>
# A Discord or Slack incoming-webhook URL also works. Tokens are removed from alerts.
# ALERT_WEBHOOK_URL=

# ── Canva (optional — branded image templates instead of raw photos) ─────────
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# CANVA_TEMPLATE_ID=
# Redirect URI registered in your Canva/Google app (default: the project's GitHub Pages callback).
# OAUTH_REDIRECT_URI=https://<you>.github.io/instagram-agent/callback.html
